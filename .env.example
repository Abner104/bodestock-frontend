# ==================================
# STOCKLY - Variables de Entorno
# ==================================
# Copia este archivo a .env y completa con tus valores reales

# ----------------------------------
# Firebase Configuration
# ----------------------------------
# Obtén estos valores desde: Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ----------------------------------
# OpenAI Configuration
# ----------------------------------
# API Key para el asistente de inventario con IA
VITE_OPENAI_API_KEY=sk-your_openai_api_key_here

# ----------------------------------
# Backend API Configuration
# ----------------------------------
# URL del backend de Stockly (sin trailing slash)
# Desarrollo: http://localhost:5188
# Producción: https://api.stockly.com
VITE_API_URL=http://localhost:5188

# ----------------------------------
# Super Admin Configuration
# ----------------------------------
# Email del super administrador del sistema
# Este usuario tendrá acceso a funciones administrativas globales
VITE_SUPER_ADMIN_EMAIL=admin@yourdomain.com

# ----------------------------------
# MercadoPago Configuration
# ----------------------------------
# Public key de MercadoPago para procesamiento de pagos
VITE_MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key

# ----------------------------------
# Google Maps / Places Configuration
# ----------------------------------
# API key con "Places API" habilitada, restringida por HTTP referrer a tu
# dominio. Se usa para el autocompletado de dirección en la tienda online.
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key

# ----------------------------------
# Application Settings
# ----------------------------------
# Entorno de ejecución
VITE_APP_ENV=development

# URL base de la aplicación
VITE_APP_URL=http://localhost:5173

# Habilitar logs de debug en consola
VITE_DEBUG_MODE=true
